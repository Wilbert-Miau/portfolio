---
interface Props {
  t: {
    copyrightOwner: string;
    rights: string;
    builtWith: string;
  };
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>&copy; {year} {t.copyrightOwner}. {t.rights}</p>
    <p class="credit">{t.builtWith} <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></p>
  </div>
</footer>

<style>
  .footer {
    padding: 2rem 0;
    text-align: center;
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
  }

  p {
    margin: 0.5rem 0;
    font-size: 0.9rem;
  }

  .credit {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
</style>
