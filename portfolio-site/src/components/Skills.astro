---
interface SkillCategory {
  title: string;
  items: string[];
  highlightCategory?: boolean;
}

interface Props {
  t: {
    sectionTitle: string;
    categories: SkillCategory[];
    highlightedSkills: string[];
  };
}

const { t } = Astro.props;
const isHighlighted = (skill: string) => t.highlightedSkills.includes(skill);
---

<section id="skills" class="section">
  <div class="container">
    <h2 class="section-title">{t.sectionTitle}</h2>
    
    <div class="skills-grid">
      {t.categories.map((category) => (
        <div class={`skill-category ${category.highlightCategory ? 'highlight' : ''}`}>
          <h3>{category.title}</h3>
          <div class="skill-list">
            {category.items.map(skill => (
              <div class={`skill-tag ${isHighlighted(skill) ? 'highlighted' : ''}`}>{skill}</div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    font-size: 2rem;
    margin-bottom: 3rem;
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 60px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .skill-category {
    background: var(--color-surface);
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    transition: transform 0.2s ease;
  }

  .skill-category:hover {
    transform: translateY(-5px);
    border-color: var(--color-accent);
  }

  .skill-category.highlight {
    background: linear-gradient(145deg, var(--color-surface), rgba(59, 130, 246, 0.05));
    border-color: rgba(59, 130, 246, 0.2);
  }

  .skill-category h3 {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
    color: var(--color-accent);
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    background: rgba(255, 255, 255, 0.05);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .skill-tag.highlighted {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2));
    border-color: rgba(59, 130, 246, 0.5);
    color: #fff;
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.3);
    font-weight: 500;
  }
</style>
