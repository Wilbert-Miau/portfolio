---
interface Props {
  t: {
    sectionTitle: string;
    name: string;
    location: string;
    timeline: string;
    description: string;
    focusTitle: string;
    focus: readonly string[];
    status: string;
  };
}
const { t } = Astro.props;
---

<section id="business" class="section bg-surface">
  <div class="container">
    <h2 class="section-title">{t.sectionTitle}</h2>
    <article class="business-card">
      <div>
        <p class="status">{t.status}</p>
        <h3>{t.name}</h3>
        <p class="meta">{t.location} · {t.timeline}</p>
        <p class="description">{t.description}</p>
      </div>
      <div>
        <h4>{t.focusTitle}</h4>
        <ul>
          {t.focus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .section-title { font-size: 2rem; margin-bottom: 2rem; position: relative; display: inline-block; }
  .section-title::after { content: ''; position: absolute; bottom: -10px; left: 0; width: 60px; height: 4px; background: var(--color-accent); border-radius: 2px; }
  .business-card { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; padding: clamp(1.25rem, 4vw, 2rem); border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
  .status { color: var(--color-accent); font-size: .9rem; margin-bottom: .75rem; }
  h3 { font-size: 1.8rem; margin-bottom: .5rem; }
  .meta { font-size: .9rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .description { line-height: 1.7; }
  h4 { font-size: 1.1rem; margin-bottom: .75rem; }
  ul { padding-left: 1.25rem; margin: 0; }
  li { margin-bottom: .75rem; line-height: 1.5; }
  li::marker { color: var(--color-accent); }
  @media (max-width: 768px) { .business-card { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
