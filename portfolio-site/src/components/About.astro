---
interface Props {
  t: {
    sectionTitle: string;
    lead: string;
    paragraphs: string[];
  };
}

const { t } = Astro.props;
const [leadAccent, ...leadRestParts] = t.lead.split(".");
const leadRest = leadRestParts.join(".").trim();
---

<section id="about" class="section bg-surface">
  <div class="container">
    <h2 class="section-title">{t.sectionTitle}</h2>
    <div class="content">
      <p class="lead">
        <span class="text-accent">{leadAccent.trim()}.</span>{leadRest ? ` ${leadRest}` : ""}
      </p>

      <div class="bio-grid">
        <div class="bio-text">
          {t.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-title {
    font-size: 2rem;
    margin-bottom: 2rem;
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 60px;
    height: 4px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .content {
    max-width: 900px;
  }

  .lead {
    font-size: 1.5rem;
    color: #fff;
    margin-bottom: 2rem;
    font-weight: 600;
  }

  .bio-text p {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  strong {
    color: #fff;
  }
</style>
